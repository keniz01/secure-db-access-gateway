.DS_Store

# Secrets
# Real secret values never enter this repository. They live in a single, local,
# gitignored env file (.env for dev, /etc/gateway/gateway.env on a host) that is
# provisioned manually from .env.example. TLS key material for the nginx edge is
# generated by scripts/bootstrap-dev.sh into certs/ and must not be committed.
.env
.env.local
.env.*
!.env.example
certs/
secrets/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
