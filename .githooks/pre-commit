#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────
# .githooks/pre-commit — blocking code review gate.
#
# INSTALL (local copy, since .git/ is not tracked):
#   cp .githooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Runs `opencode run --command code-review` (non-interactive) against the
# staged diff, prints the findings, then requires a manual y/N before the
# commit is allowed. In non-interactive contexts (CI, piped stdin) the review
# still runs and its report is printed, but the y/N gate is skipped.
#
# REVIEW_MODEL overrides the model used for the review. Default is the free,
# fast muse-spark model; set e.g.
# REVIEW_MODEL=opencode/big-pickle to fall back to the stricter default.
#
# Toggle: BLOCK=false turns this into an advisory report that never blocks.
# Uninstall: rm .git/hooks/pre-commit
# ─────────────────────────────────────────────────────────────

set -euo pipefail

BLOCK=false
OPENCODE_BIN="${OPENCODE_BIN:-opencode}"

if git diff --cached --quiet; then
  echo "No staged changes; skipping code review gate."
  exit 0
fi

export NO_COLOR=1

echo ""
echo "╔══════════════════════════════════════════════════╗"
echo "║        🔍 Code Review (opencode)                  ║"
echo "╚══════════════════════════════════════════════════╝"
echo ""
echo "Reviewing staged changes with opencode..."

if ! REVIEW_OUTPUT=$("$OPENCODE_BIN" run --command code-review -m "${REVIEW_MODEL:-opencode/muse-spark-1.2-contributor-free}" 2>&1); then
  REVIEW_EXIT=$?
  echo "⚠️  opencode review failed (exit $REVIEW_EXIT). Skipping automated review; manual gate still applies when run interactively."
  REVIEW_OUTPUT=""
fi

echo ""
echo "$REVIEW_OUTPUT"
echo ""

if [ "$BLOCK" = true ] && [ -t 0 ]; then
  read -r -p "Review complete. Approve this commit? [y/N] " response
  case "$response" in
    [yY][eE][sS]|[yY])
      echo "✅ Commit approved."
      ;;
    *)
      echo "❌ Commit blocked by review gate."
      exit 1
      ;;
  esac
elif [ "$BLOCK" = true ]; then
  echo "Non-interactive commit; review report shown above, proceeding."
fi

exit 0
