# Copy this file to `.env` (gitignored — development) or `/etc/gateway/gateway.env`
# on a production host, then fill in real values. Never commit a file with values.
#
#   ./scripts/bootstrap-dev.sh        # copies .env.example -> .env (dev)
#   docker compose --env-file /etc/gateway/gateway.env up -d --build   (production)
#
# Values containing spaces, '#' or other special characters must be quoted
# (e.g. VALUE="quoted value"). JSON values MUST be a single line.

# production|prod fail-fast on missing required secrets (recommended default);
# use `development` for throwaway local runs.
ENVIRONMENT=production

# --- Session signing key (auth0_api). Generate with: openssl rand -hex 32 ---
APP_SECRET_KEY=

# --- Auth0 (auth0_api + sql_query_api) ---
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://secure-db-access-gateway-api

# --- Frontend / UI ---
VITE_APP_TITLE=Database Access Gateway

# --- CORS ---
FRONTEND_URL=https://localhost:8443
REACT_APP_URL=https://localhost:8443
CORS_ORIGINS=http://localhost:5173,https://localhost:5173,https://localhost:8443

# --- Session cookie (auth0_api) ---
# SESSION_MAX_AGE: seconds until the server-side session (and both the
# gateway_session and csrf_token cookies) expire.
SESSION_MAX_AGE=3600
# SESSION_COOKIE_SECURE: mark cookies Secure. Auto-enforced (true) in
# production; defaults to false only for plain-HTTP localhost development.
# SESSION_COOKIE_SECURE=false
# OAUTH_REDIRECT_URI: static pre-registered callback (OAuth 2.1). Must be listed in
# Auth0 Allowed Callback URLs. Defaults to FRONTEND_URL + /auth.
# OAUTH_REDIRECT_URI=https://localhost:8443/auth
# REDIS_URL: required in production; auth0_api fails fast if unset. Docker Compose
# provides redis://redis:6379/0 by default. Set REDIS_PASSWORD to require auth.
REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD: set to require AUTH on redis (recommended prod). When set,
# set REDIS_URL to redis://:PASSWORD@redis:6379/0 or use REDIS_PASSWORD_FILE.
# REDIS_PASSWORD=
# REDIS_PASSWORD_FILE=/run/secrets/redis_password

# --- AI (auth0_api) ---
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
AI_BASE_URL=https://openrouter.ai/api/v1
AI_DISABLE_REASONING=true

# --- Database (sql_query_api) ---
# Connection used when running a real database service directly, and by the
# headless operator CLI (explore.py).
DATABASE_URL=postgresql+asyncpg://user:pass@host.docker.internal:5432/analysis

# Opaque logical tenant database mapping. Clients only ever send database_id,
# never connection strings. One line; replace with real org/database bindings.
# Production: each connection_string MUST use the dedicated SELECT-only gateway
# role (see sql_query_api/scripts/setup_least_privilege_gateway_role.sql) and map
# its user/password to that role. Never use an owner/superuser account.
TENANT_DATABASES_JSON=[{"org_id":"replace-with-auth0-org-id","database_id":"default","connection_string":"postgresql+asyncpg://user:pass@host.docker.internal:5432/analysis","data_schema":"music","metadata_schema":"meta"}]

# --- Policy (OPA bundle — preferred) ---
# Policies are now managed as OPA bundles, not inline JSON. See
# sql_query_api/opa/policies/gateway.rego + sql_query_api/opa/data.json
# and scripts/build-opa-bundle.sh. Dev still mounts them via
# docker-compose.yml opa volumes; prod hot-reloads via bundle polling
# (BUNDLE_SERVICE_URL + sql_query_api/opa/config.yaml).
#
# Deprecated fallback (will be removed): inline JSON evaluated in-process
# when OPA_ENABLED=false. Only for `ENVIRONMENT=dev` throwaway runs.
# Default-deny starter policy: one allow rule per table so governed queries
# work with a fresh scaffold. One line; restrict further via columns/row_scope
# per sql_query_api/README.md "Policy enforcement". "[]" boots with no rules.
POLICY_POLICIES_JSON=[{"id":"allow-album","effect":"allow","org_id":"replace-with-auth0-org-id","database_id":"default","table":"album","columns":["album_id","title","duration","total_tracks","release_year","genre_id","label_id","artist_id"]},{"id":"allow-artist","effect":"allow","org_id":"replace-with-auth0-org-id","database_id":"default","table":"artist","columns":["artist_id","artist_name"]},{"id":"allow-genre","effect":"allow","org_id":"replace-with-auth0-org-id","database_id":"default","table":"genre","columns":["genre_id","genre_name"]},{"id":"allow-label","effect":"allow","org_id":"replace-with-auth0-org-id","database_id":"default","table":"label","columns":["label_id","label_name"]},{"id":"allow-record-label","effect":"allow","org_id":"replace-with-auth0-org-id","database_id":"default","table":"record_label","columns":["label_id","label_name"]},{"id":"allow-recording-artist","effect":"allow","org_id":"replace-with-auth0-org-id","database_id":"default","table":"recording_artist","columns":["artist_id","artist_name"]},{"id":"allow-track","effect":"allow","org_id":"replace-with-auth0-org-id","database_id":"default","table":"track","columns":["track_id","title","duration","position","release_year","genre_id","label_id","artist_id","album_id"]}]

# --- SQL gateway tunables (optional) ---
SQL_DATA_SCHEMA=music
SQL_QUERY_COST_THRESHOLD=16

# Application-side per-query budgets, pushed to every PostgreSQL session. The
# DATABASE enforces its own role-level budgets too (statement_timeout,
# lock_timeout, idle_in_transaction_session_timeout, work_mem) — provisioned by
# sql_query_api/scripts/setup_least_privilege_gateway_role.sql. Keep
# SQL_QUERY_TIMEOUT_SECONDS <= the role's gateway_statement_timeout so the app
# budget never loosens the DB backstop.
SQL_QUERY_TIMEOUT_SECONDS=30
SQL_LOCK_TIMEOUT_SECONDS=5

# Bounded per-tenant SQLAlchemy connection pool (PostgreSQL only). The pool is
# per tenant database (primary + read replica are separate engines), so the
# total connections to a cluster = sum over engines of (DB_POOL_SIZE +
# DB_MAX_OVERFLOW) and must stay below the role's connection limit
# (gateway_connection_limit in the provisioning script).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Per-tenant pool overrides (optional, in TENANT_DATABASES_JSON):
#   pool_size: int (default: DB_POOL_SIZE)
#   max_overflow: int (default: DB_MAX_OVERFLOW)
#   pool_timeout: float seconds (default: DB_POOL_TIMEOUT_SECONDS)
#   pool_recycle: int seconds (default: DB_POOL_RECYCLE_SECONDS)
# Example entry:
# {"org_id":"org-1","database_id":"analytics","connection_string":"postgresql+asyncpg://...",
#  "pool_size":10,"max_overflow":20,"pool_timeout":60,"pool_recycle":3600}

# Dedicated PostgreSQL read-only role the gateway SET ROLEs into on every
# connection (defense-in-depth). REQUIRED in production for PostgreSQL tenants:
# the gateway fails fast at startup if this is unset. Provision it with
# sql_query_api/scripts/setup_least_privilege_gateway_role.sql; the value is the
# bare role name (e.g. gateway_readonly_user), never qualified.
SQL_READONLY_ROLE=gateway_readonly_user

# --- Result presentation planning (optional LLM enhancemen only) ---
# After a query executes, an LLM decides whether the result is shown as a
# paragraph, list, or table. Pure enhancement: on any LLM failure or when
# OPENROUTER_API_KEY is unset, the raw rows always render as a table.
SQL_PRESENTATION_ENABLED=true
# Bounds on what is sent to the LLM (never the full result set).
SQL_PRESENTATION_MAX_SAMPLE_ROWS=20
SQL_PRESENTATION_MAX_CELL_CHARS=80
SQL_PRESENTATION_MAX_PAYLOAD_BYTES=20000
SQL_PRESENTATION_MAX_TOKENS=300

# --- Open Policy Agent (OPA) ---
# OPA sidecar URL for centralized policy evaluation. When enabled, the gateway
# delegates policy decisions to OPA instead of using the built-in evaluator.
# Set OPA_ENABLED=false for local dev without Docker (uvicorn --port 8002).
# Prod: docker-compose.prod.yml sets OPA_ENABLED=true and OPA to bundle mode.
OPA_URL=http://opa:8181
OPA_ENABLED=false
# Bundle hot-reload (prod): OPA fetches bundles directly, not via the app.
# Build with scripts/build-opa-bundle.sh -> sql_query_api/bundle.tar.gz and
# serve via opa-bundle-server or external HTTP (S3/GCS/Gitea).
# BUNDLE_SERVICE_URL=http://opa-bundle-server:8080
# OPA_BUNDLE_URL is not read by the app; configure in sql_query_api/opa/config.yaml

# --- Headless operator CLI (explore.py, optional) ---
CLI_ACCESS_TOKEN=